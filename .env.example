DECKMATE_DATA="D:/Projects/MyProject"
# 2026-11-05: edits go directly into DECKMATE_DATA by default; git history is recommended.
# Optional separate worktree outside the project, on the deckmate/sandbox branch.
# DECKMATE_WRITE="D:/Projects/MyProject-sandbox"
# Disable writes, including when a separate copy is configured; CLI equivalent: --read-only.
# DECKMATE_READ_ONLY=1
DECKMATE_PROJECT_NAME="My project"
DECKMATE_PORT=4317
# DECKMATE_PYTHON="python"
# DECKMATE_INDEX="D:/Caches/Deckmate"
# Docker only: bind inside the container; publish its port on host loopback.
# DECKMATE_HOST=0.0.0.0
