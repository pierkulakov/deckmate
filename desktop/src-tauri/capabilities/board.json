{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "board",
  "description": "Loopback board: only recent projects and return to the start screen.",
  "local": false,
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "windows": ["main"],
  "permissions": [
    "allow-board-recent-projects",
    "allow-board-switch-project",
    "allow-board-show-start-screen"
  ]
}
