{
  "name": "deckmate",
  "version": "0.7.0",
  "description": "A local Markdown project board for teams of people and AI agents. Card decks, Runs and Journeys as plain files in your repository; no account, no cloud sync.",
  "license": "AGPL-3.0-only",
  "author": "pierkulakov",
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "markdown",
    "kanban",
    "project-management",
    "project-board",
    "task-management",
    "local-first",
    "offline",
    "ai-agents",
    "claude-code",
    "game-development",
    "agent-skills",
    "planning",
    "git",
    "excalidraw",
    "cli"
  ],
  "type": "module",
  "scripts": {
    "skills": "node tools/deckmate-skills.ts",
    "agents": "node tools/deckmate-run.ts",
    "project": "node --env-file-if-exists=.env.local tools/project.ts",
    "check": "node --env-file-if-exists=.env.local tools/check.ts",
    "quiet": "node tools/agent-quiet.ts",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:client && npm run build:server",
    "start": "node bin/deckmate.mjs",
    "dev": "node tools/dev.ts",
    "capture": "node tools/layout-capture.ts",
    "capture:launcher": "node tools/launcher-capture.ts",
    "desktop:smoke": "node tools/desktop-smoke.ts",
    "desktop:updater-e2e": "node tools/updater-e2e.ts",
    "shots": "node tools/readme-shots.ts",
    "build:client": "vite build --config app.vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "fastify": "5.12.8",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "ws": "8.22.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "0.19.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "bin": {
    "deckmate": "bin/deckmate.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "assets/journey-templates/",
    "assets/project-templates/",
    "assets/templates/",
    "assets/README.md",
    "skills/",
    "docs/agents-config.md",
    "docs/api.md",
    "docs/catalog.md",
    "docs/skills.md",
    "PRODUCT.md",
    "tools/rebuild-board.py",
    "README.ru.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CHANGELOG.ru.md",
    ".env.example",
    "assets/fonts/**/OFL.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierkulakov/deckmate.git"
  },
  "homepage": "https://github.com/pierkulakov/deckmate#readme",
  "bugs": {
    "url": "https://github.com/pierkulakov/deckmate/issues"
  }
}
